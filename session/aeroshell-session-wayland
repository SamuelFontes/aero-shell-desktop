#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

die() {
    printf 'AeroShell: %s\n' "$*" >&2
    exit 1
}

[[ -n "${HOME:-}" && "$HOME" == /* ]] || die 'HOME must be an absolute path.'
[[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]] || die 'XDG_RUNTIME_DIR is unavailable; start AeroShell from a normal graphical login.'

xdg_base() {
    local variable="$1" fallback="$2" value="${!1:-}"
    if [[ -n "$value" && "$value" == /* ]]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$fallback"
    fi
}

profile_root() {
    local base="$1"
    # Always derive the private root from the original user-supplied XDG base.
    # A user may legitimately choose a base directory whose own name is
    # "aeroshell"; the basename does not mean the private layer was appended.
    printf '%s/aeroshell\n' "${base%/}"
}

user_config_home="$(xdg_base XDG_CONFIG_HOME "$HOME/.config")"
user_data_home="$(xdg_base XDG_DATA_HOME "$HOME/.local/share")"
user_cache_home="$(xdg_base XDG_CACHE_HOME "$HOME/.cache")"
user_state_home="$(xdg_base XDG_STATE_HOME "$HOME/.local/state")"
for xdg_base_dir in "$user_config_home" "$user_data_home" "$user_cache_home" "$user_state_home"; do
    [[ "$xdg_base_dir" != "/" ]] || die 'XDG base directories must not be the filesystem root.'
done

profile_config="$(profile_root "$user_config_home")"
profile_data="$(profile_root "$user_data_home")"
profile_cache="$(profile_root "$user_cache_home")"
profile_state="$(profile_root "$user_state_home")"
private_roots=(
    "$profile_config" "$profile_config/kwin" "$profile_config/kwin/config"
    "$profile_data" "$profile_data/kwin" "$profile_data/kwin/data"
    "$profile_cache" "$profile_cache/kwin" "$profile_cache/kwin/cache"
    "$profile_state" "$profile_state/kwin" "$profile_state/kwin/state"
)

# Refuse redirections at each AeroShell-owned path. Parent XDG roots may be
# user-selected symlinks; only the new AeroShell subtree is package/session-owned.
for path in "${private_roots[@]}"; do
    [[ ! -L "$path" ]] || die "Refusing to use symlinked AeroShell profile path: $path"
    [[ ! -e "$path" || -d "$path" ]] || die "AeroShell profile path is not a directory: $path"
done
kwin="$(command -v kwin_wayland || true)"
[[ -n "$kwin" ]] || die 'KWin Wayland compositor (kwin_wayland) is not installed.'
dbus_run_session="$(command -v dbus-run-session || true)"
[[ -n "$dbus_run_session" ]] || die 'dbus-run-session is required to isolate AeroShell from other desktop sessions.'
install_prefix="${AEROSHELL_PREFIX:-/opt/aeroshell}"
[[ "$install_prefix" == /* ]] || die 'AEROSHELL_PREFIX must be absolute.'
kwinrc_path="$profile_config/kwin/config/kwinrc"
screenlockerrc_path="$profile_config/kwin/config/kscreenlockerrc"
default_kwinrc="$install_prefix/share/aeroshell/defaults/kwinrc"
default_screenlockerrc="$install_prefix/share/aeroshell/defaults/kscreenlockerrc"
qt_quick_controls_config="$install_prefix/share/aeroshell/qtquickcontrols2.conf"
aero_decoration_dir="$install_prefix/share/aeroshell/aurorae/themes/Se7enAero"
look_and_feel_dir="$install_prefix/share/plasma/look-and-feel/org.aeroshell.desktop"
[[ -f "$default_kwinrc" ]] || die "AeroShell's default KWin appearance is missing: $default_kwinrc"
[[ -f "$default_screenlockerrc" ]] || die "AeroShell's default lock-screen appearance is missing: $default_screenlockerrc"
[[ -f "$qt_quick_controls_config" ]] || die "AeroShell's default Qt Quick appearance is missing: $qt_quick_controls_config"
[[ -f "$aero_decoration_dir/metadata.desktop" && -f "$aero_decoration_dir/decoration.svg" ]] \
    || die "AeroShell's Se7en Aero window decoration is incomplete: $aero_decoration_dir"
[[ -f "$look_and_feel_dir/metadata.json" \
    && -f "$look_and_feel_dir/contents/lockscreen/LockScreen.qml" \
    && -f "$look_and_feel_dir/contents/lockscreen/LockScreenUi.qml" \
    && -f "$look_and_feel_dir/contents/sounds/lockSuccess.ogg" ]] \
    || die "AeroShell's default lock-screen package is incomplete: $look_and_feel_dir"
for config_path in "$kwinrc_path" "$screenlockerrc_path"; do
    [[ ! -L "$config_path" ]] || die "Refusing to use a symlinked AeroShell config: $config_path"
    [[ ! -e "$config_path" || -f "$config_path" ]] || die "AeroShell config path is not a regular file: $config_path"
    if [[ -e "$config_path" ]]; then
        config_links="$(stat -c '%h' -- "$config_path")"
        [[ "$config_links" == 1 ]] || die "Refusing to use a shared AeroShell config with $config_links hard links: $config_path"
    fi
done
shell_wrapper="$install_prefix/libexec/aeroshell-shell-session"
[[ -x "$shell_wrapper" ]] || die "AeroShell shell launcher is missing: $shell_wrapper"
compatibility_checker="$install_prefix/libexec/aeroshell-check-compatibility"
[[ -x "$compatibility_checker" ]] || die "AeroShell compatibility checker is missing: $compatibility_checker"
"$compatibility_checker" "$kwin"

for path in "${private_roots[@]}"; do
    mkdir -p -- "$path" || die "Cannot create AeroShell profile path: $path"
done
if [[ ! -e "$kwinrc_path" ]]; then
    install -m 600 -- "$default_kwinrc" "$kwinrc_path" \
        || die "Cannot install AeroShell's private KWin appearance defaults: $kwinrc_path"
fi
if [[ ! -e "$screenlockerrc_path" ]]; then
    install -m 600 -- "$default_screenlockerrc" "$screenlockerrc_path" \
        || die "Cannot install AeroShell's private lock-screen defaults: $screenlockerrc_path"
fi

aero_data_dir="$install_prefix/share/aeroshell"
install_share_dir="$install_prefix/share"
current_data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for data_dir in "$aero_data_dir" "$install_share_dir"; do
    case ":$current_data_dirs:" in
        *":$data_dir:"*) ;;
        *) current_data_dirs="$data_dir:$current_data_dirs" ;;
    esac
done
current_cursor_paths="${XCURSOR_PATH:-/usr/share/icons}"
case ":$current_cursor_paths:" in
    *":$aero_data_dir/cursors:"*) ;;
    *) current_cursor_paths="$aero_data_dir/cursors:$current_cursor_paths" ;;
esac

export AEROSHELL_USER_XDG_CONFIG_HOME="$user_config_home"
export AEROSHELL_USER_XDG_DATA_HOME="$user_data_home"
export AEROSHELL_USER_XDG_CACHE_HOME="$user_cache_home"
export AEROSHELL_USER_XDG_STATE_HOME="$user_state_home"

export XDG_CONFIG_HOME="$profile_config/kwin/config"
export XDG_DATA_HOME="$profile_data/kwin/data"
export XDG_CACHE_HOME="$profile_cache/kwin/cache"
export XDG_STATE_HOME="$profile_state/kwin/state"
export XDG_CURRENT_DESKTOP="AeroShell"
export XDG_SESSION_DESKTOP="aeroshell"
export XDG_SESSION_TYPE="wayland"
export DESKTOP_SESSION="aeroshell"
export XDG_DATA_DIRS="$current_data_dirs"
export GTK_THEME="AeroShellAero"
export FONTCONFIG_FILE="$aero_data_dir/fontconfig/fonts.conf"
export QT_QUICK_CONTROLS_CONF="$qt_quick_controls_config"
export XCURSOR_THEME="aero-drop"
export XCURSOR_PATH="$current_cursor_paths"
export XCURSOR_SIZE="${AEROSHELL_CURSOR_SIZE:-24}"

# Give this desktop its own session bus. KDE and AeroShell can then register
# independent KWin, notification, StatusNotifier, and portal-related names.
# The system bus and user files remain shared; the shell wrapper restores the
# user's original XDG roots before launching normal applications.
exec "$dbus_run_session" -- "$kwin" --xwayland --desktopfile aeroshell --exit-with-session "$shell_wrapper"
