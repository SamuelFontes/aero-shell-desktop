# Maintainer: Samuel Fontes
pkgname=aeroshell-desktop-git
pkgver=0.1.0.r1.g0000000
pkgrel=1
pkgdesc='Independent Wayland desktop with preconfigured AeroThemePlasma defaults'
arch=('x86_64' 'aarch64')
url='https://github.com/SamuelFontes/aero-shell-desktop'
license=('MIT' 'CC0-1.0')
depends=(
  'kwin>=6.7.4'
  'kwin<6.7.5'
  'dbus'
  'kscreenlocker>=6.7.4'
  'kscreenlocker<6.7.5'
  'plasma-workspace'
  'plasma5support'
  'qt6-base>=6.8'
  'qt6-wayland'
  'xorg-xwayland'
  'qt6-declarative>=6.8'
  'qt6-svg'
  'qt6-5compat'
  'qt6-multimedia'
  'kio'
  'kservice'
  'kconfig'
  'konsole'
  'spectacle'
  'kwayland>=6.7.4'
  'kwayland<6.7.5'
  'polkit-qt6'
  'networkmanager'
  'libcanberra'
  'libpulse'
  'noto-fonts'
  'adwaita-icon-theme'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-kde'
)
makedepends=('cmake' 'ninja' 'git' 'python' 'desktop-file-utils')
optdepends=(
  'wireplumber: Volume controls through wpctl'
)
provides=('aeroshell-desktop')
conflicts=('aeroshell-desktop')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  printf '0.1.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}"
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/aeroshell
  cmake --build build
}

check() {
  cd "${srcdir}/${pkgname}"
  qmllint -I build/qmltypes -I /usr/lib/qt6/qml src/shell/qml/*.qml
  qmllint -I build/qmltypes -I /usr/lib/qt6/qml \
    assets/plasma/shells/org.aeroshell.desktop/contents/lockscreen/*.qml
  desktop-file-validate session/aeroshell.desktop
  desktop-file-validate session/org.aeroshell.shell.desktop
  desktop-file-validate session/org.aeroshell.explorer.desktop
  ctest --test-dir build --output-on-failure
  python tests/test-install-policy.py
  python tests/test-source-lock.py
}

package() {
  cd "${srcdir}/${pkgname}"
  DESTDIR="${pkgdir}" cmake --install build
  python scripts/audit-install-manifests.py --stage-root "${pkgdir}"
}
