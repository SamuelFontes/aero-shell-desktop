# Maintainer: Samuel Fontes
pkgname=aeroshell-desktop-git
pkgver=0.1.0.r1.g0000000
pkgrel=1
pkgdesc='Original AeroThemePlasma desktop in an isolated, preconfigured Wayland session'
arch=('x86_64' 'aarch64')
url='https://github.com/SamuelFontes/aero-shell-desktop'
license=('MIT' 'CC0-1.0' 'GPL-2.0-or-later' 'AGPL-3.0-only')
depends=(
  'kwin>=6.7.4'
  'kwin<6.7.5'
  'dbus'
  'kscreenlocker>=6.7.4'
  'kscreenlocker<6.7.5'
  'plasma-workspace'
  'plasma-desktop'
  'plasma-nm'
  'plasma-pa'
  'powerdevil'
  'kvantum'
  'qqc2-desktop-style'
  'dolphin'
  'python'
  'plasma5support'
  'qt6-base>=6.8'
  'qt6-wayland'
  'xorg-xwayland'
  'qt6-declarative>=6.8'
  'qt6-svg'
  'ksvg'
  'qt6-5compat'
  'qt6-multimedia'
  'kio'
  'kservice'
  'kwindowsystem'
  'kdecoration'
  'kconfig'
  'konsole'
  'spectacle'
  'kwayland>=6.7.4'
  'kwayland<6.7.5'
  'polkit-qt6'
  'networkmanager'
  'libcanberra'
  'libpulse'
  'noto-fonts'
  'adwaita-icon-theme'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-kde'
)
makedepends=('cmake' 'ninja' 'git' 'python' 'desktop-file-utils' 'extra-cmake-modules' 'vulkan-headers' 'wayland-protocols' 'qt6-tools' 'qt6-wayland' 'libksysguard')
optdepends=(
  'wireplumber: Volume controls through wpctl'
)
provides=('aeroshell-desktop')
conflicts=('aeroshell-desktop')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  printf '0.1.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}"
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/aeroshell \
    -DAEROSHELL_NATIVE_STAGE="${AEROSHELL_NATIVE_STAGE:-}"
  cmake --build build
}

check() {
  cd "${srcdir}/${pkgname}"
  desktop-file-validate session/aeroshell.desktop
  ctest --test-dir build --output-on-failure
}

package() {
  cd "${srcdir}/${pkgname}"
  DESTDIR="${pkgdir}" cmake --install build
  python scripts/audit-install-manifests.py --stage-root "${pkgdir}"
}
